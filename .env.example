# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration Template for Threads-Bot
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to Git!
# ─────────────────────────────────────────────────────────────────────────────

# Required Secrets
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key
TG_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
CRYPTO_PAY_TOKEN=12345:AAGMYyourCryptoPayToken
SECRET_AUTH_KEY=replace_with_32_plus_random_secret_chars

# Threads / Meta OAuth Application
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret
REDIRECT_URI=

# Optional Settings
TG_BOT_USERNAME=ThreadsFarmAuthBot
DB_NAME=farm.db
BASE_URL=
